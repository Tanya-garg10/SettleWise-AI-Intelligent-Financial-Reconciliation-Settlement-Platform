        {
          "name": "Create PayPal Sandbox Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2200.00,\n  \"currency\": \"USD\",\n  \"invoiceId\": \"INV-1011\",\n  \"description\": \"Quarterly Security Audit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/paypal/create-order",
