          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "paypal-auth-algo", "value": "SHA256withRSA" },
              { "key": "paypal-transmission-id", "value": "test-transmission-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-EVT-9921\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"summary\": \"Payment capture completed for $2,200.00 USD\",\n  \"resource\": {\n    \"id\": \"CAP-SANDBOX-1982\",\n    \"amount\": {\n      \"value\": \"2200.00\",\n      \"currency_code\": \"USD\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/paypal/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paypal", "webhook"]
            }
          }
        }
