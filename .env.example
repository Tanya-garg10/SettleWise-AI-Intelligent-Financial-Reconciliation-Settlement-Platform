# SettleWise AI Environment Configuration

# Application Port & URLs
PORT=3000
FRONTEND_URL=http://localhost:3000
APP_ENV=development

# Google Gemini API (For financial investigations & AI Assistant)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# PayPal Sandbox Developer Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id

# Database (For standalone PostgreSQL / FastAPI deployment on Render)
DATABASE_URL=sqlite:///./settlewise.db
SECRET_KEY=replace_with_secure_random_key_for_production
